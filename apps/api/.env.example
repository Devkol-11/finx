NODE_ENV=development
HOST=0.0.0.0
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finx
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
REQUEST_BODY_LIMIT_BYTES=1048576

JWT_SECRET_DEV=replace-with-at-least-32-characters-dev
JWT_SECRET_PROD=replace-with-at-least-32-characters-prod
JWT_REFRESH_SECRET_DEV=replace-with-a-distinct-32-character-dev-refresh-secret
JWT_REFRESH_SECRET_PROD=replace-with-a-distinct-32-character-prod-refresh-secret

PAYSTACK_SECRET_KEY_DEV=sk_test_replace_me
PAYSTACK_SECRET_KEY_PROD=sk_live_replace_me

RESEND_SANDBOX_API_KEY=re_replace_me
RESEND_PRODUCTION_API_KEY=re_replace_me

# Optional. Set this in production if /metrics is reachable outside a private network.
METRICS_BEARER_TOKEN=replace-with-at-least-24-random-characters
